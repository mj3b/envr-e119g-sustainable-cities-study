{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linked research objects; source claims remain canonical in cross-course",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "research_question",
          "hypothesis",
          "assumption",
          "actor",
          "authority",
          "decision",
          "decision_evidence",
          "timeline_event",
          "measurement",
          "contradiction",
          "alternative",
          "outcome"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "evidence_class": {
        "const": "our_synthesis"
      },
      "status": {
        "enum": [
          "proposed",
          "reported",
          "documented",
          "unknown"
        ]
      },
      "candidate_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "claim_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "human_review": {
        "enum": [
          "pending",
          "approved"
        ]
      },
      "limitations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "data": {
        "type": "object"
      }
    },
    "required": [
      "id",
      "type",
      "title",
      "evidence_class",
      "status",
      "candidate_ids",
      "claim_ids",
      "source_ids",
      "human_review",
      "limitations",
      "data"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "research_question"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "question_kind": {
                  "enum": [
                    "descriptive",
                    "explanatory",
                    "causal",
                    "normative"
                  ]
                },
                "boundary": {
                  "type": "string",
                  "minLength": 1
                },
                "answerability": {
                  "type": "string",
                  "minLength": 1
                },
                "update_condition": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "question",
                "question_kind",
                "boundary",
                "answerability",
                "update_condition"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "hypothesis"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "string",
                  "minLength": 1
                },
                "mechanism": {
                  "type": "string",
                  "minLength": 1
                },
                "prediction": {
                  "type": "string",
                  "minLength": 1
                },
                "disconfirming_evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "rival": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "question_id",
                "mechanism",
                "prediction",
                "disconfirming_evidence",
                "rival",
                "test"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "assumption"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_consequence": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": [
                    "untested",
                    "supported",
                    "weakened",
                    "rejected"
                  ]
                }
              },
              "required": [
                "statement",
                "test",
                "failure_consequence",
                "state"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "actor"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "stated_position": {
                  "type": "string",
                  "minLength": 1
                },
                "incentive_hypothesis": {
                  "type": "string",
                  "minLength": 1
                },
                "population_boundary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "role",
                "stated_position",
                "incentive_hypothesis",
                "population_boundary"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "authority"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "jurisdiction": {
                  "type": "string",
                  "minLength": 1
                },
                "instrument": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_status": {
                  "enum": [
                    "documented",
                    "reported",
                    "unknown"
                  ]
                },
                "limits": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "actor_id",
                "action",
                "jurisdiction",
                "instrument",
                "authority_status",
                "limits"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "decision"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "decision_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "authority_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "record_status": {
                  "enum": [
                    "recorded_vote",
                    "reported",
                    "proposed",
                    "unknown"
                  ]
                },
                "boundary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "alternative_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "outcome_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "unresolved": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "decision_date",
                "authority_id",
                "action",
                "record_status",
                "boundary",
                "evidence_ids",
                "alternative_ids",
                "outcome_ids",
                "unresolved"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "decision_evidence"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "event_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "published_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "available_to_actor_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "availability": {
                  "enum": [
                    "documented_at_decision",
                    "later",
                    "unknown"
                  ]
                },
                "availability_basis": {
                  "type": "string",
                  "minLength": 1
                },
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "record_role": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "decision_id",
                "event_date",
                "published_date",
                "available_to_actor_date",
                "availability",
                "availability_basis",
                "actor_id",
                "locator",
                "record_role",
                "content"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "timeline_event"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "event_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "date_precision": {
                  "enum": [
                    "day",
                    "month",
                    "year",
                    "unknown"
                  ]
                }
              },
              "required": [
                "event_date",
                "decision_id",
                "event",
                "evidence_ids",
                "date_precision"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "measurement"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity_kind": {
                  "enum": [
                    "power",
                    "energy",
                    "water_volume",
                    "money",
                    "population",
                    "emissions",
                    "other"
                  ]
                },
                "observation_status": {
                  "enum": [
                    "observed",
                    "reported",
                    "modeled",
                    "projected",
                    "illustrative",
                    "unknown"
                  ]
                },
                "geography": {
                  "type": "string",
                  "minLength": 1
                },
                "time_period": {
                  "type": "string",
                  "minLength": 1
                },
                "system_boundary": {
                  "type": "string",
                  "minLength": 1
                },
                "baseline": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "uncertainty": {
                  "type": "string",
                  "minLength": 1
                },
                "independence": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "input_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "assumption_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "metric",
                "value",
                "unit",
                "quantity_kind",
                "observation_status",
                "geography",
                "time_period",
                "system_boundary",
                "baseline",
                "method",
                "uncertainty",
                "independence",
                "locator",
                "input_ids",
                "assumption_ids"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "contradiction"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "left_claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "right_claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "discrepancy": {
                  "type": "string",
                  "minLength": 1
                },
                "comparability": {
                  "type": "string",
                  "minLength": 1
                },
                "resolution_status": {
                  "enum": [
                    "open",
                    "resolved",
                    "different_boundaries"
                  ]
                },
                "resolution_test": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "left_claim_id",
                "right_claim_id",
                "discrepancy",
                "comparability",
                "resolution_status",
                "resolution_test",
                "consequence"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "alternative"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "enum": [
                    "documented_proposal",
                    "analyst_proposed"
                  ]
                },
                "feasibility": {
                  "type": "string",
                  "minLength": 1
                },
                "tradeoff": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              },
              "required": [
                "decision_id",
                "description",
                "origin",
                "feasibility",
                "tradeoff",
                "locator"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "outcome"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "enum": [
                    "output",
                    "outcome"
                  ]
                },
                "outcome_status": {
                  "enum": [
                    "unknown",
                    "reported",
                    "observed",
                    "modeled",
                    "projected"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "measurement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "comparison": {
                  "type": "string",
                  "minLength": 1
                },
                "causal_status": {
                  "enum": [
                    "not_established",
                    "association_only",
                    "supported"
                  ]
                },
                "competing_explanations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "decision_id",
                "stage",
                "outcome_status",
                "description",
                "measurement_ids",
                "comparison",
                "causal_status",
                "competing_explanations"
              ],
              "additionalProperties": false
            }
          }
        }
      }
    ]
  }
}
